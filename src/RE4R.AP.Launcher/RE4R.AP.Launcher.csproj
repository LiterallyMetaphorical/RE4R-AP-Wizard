<Project Sdk="Microsoft.NET.Sdk">

  <!-- The AP Wizard artwork (design by @alrightness), shown on the landing
       screen. A Resource rather than Content: it is part of the UI, so it
       belongs inside the exe and does not need to survive as a loose file the
       way the payload in assets\ does. -->
  <ItemGroup>
    <Resource Include="Assets\wizard.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RE4R.AP.Launcher.Core\RE4R.AP.Launcher.Core.csproj" />
  </ItemGroup>

  <!-- ExcludeFromSingleFile on every asset: under PublishSingleFile these Content
       files (notably the 107 MB biorand-re4r.exe and its DLLs, plus lua-apclientpp.dll)
       would otherwise be embedded INTO the launcher exe. BioRand is spawned as a
       child process and the native DLL is loaded by REFramework, so both MUST stay
       as loose files on disk beside the exe. This keeps them in assets\ where every
       service resolves them via AppContext.BaseDirectory. -->
  <ItemGroup>
    <Content Include="..\..\assets\BioRand\**\*">
      <Link>assets\BioRand\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\..\assets\Data\re4r_ap_static.json" Link="assets\Data\re4r_ap_static.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- The BioRand options catalog: GENERATED from BioRand's own
         Re4rRandomizerConfigurationDefinition, so keys/labels/types/defaults match BioRand
         exactly. BioRandOptionCatalog loads this; re-dump it when BioRand's options change. -->
    <Content Include="..\..\assets\Data\biorand_options.json" Link="assets\Data\biorand_options.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- Enemy preset curves (Crowd x Roster axes, class multipliers, HP positions,
         possession gates). EnemyConfigurationPresets loads this; retunes are a data
         edit + restage, no rebuild. Design doc: ENEMY_CLASS_DESIGN.md (untracked). -->
    <Content Include="..\..\assets\Data\enemy_presets.json" Link="assets\Data\enemy_presets.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- The shipped RE4R.apworld lives here (not in assets/Archipelago, which is
         deleted with the hosting cut): Generation Guidance hands this file to the
         organizer to copy into their own Archipelago's custom_worlds folder. -->
    <Content Include="..\..\assets\Data\RE4R.apworld" Link="assets\Data\RE4R.apworld">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\..\assets\Lua\**\*">
      <Link>assets\Lua\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\..\assets\native\**\*">
      <Link>assets\native\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- The loose text files at the assets root: the BioRand and apworld
         provenance records, and the third-party notices. This include is not
         optional housekeeping - every release redistributes a compiled BioRand
         build, and MIT requires BioRand's notice to travel with it. The Linux
         project globs assets\**\* so it always carried these; the Windows one
         enumerates subfolders, so without this line they shipped on Linux and
         silently did not ship here. -->
    <Content Include="..\..\assets\*.txt">
      <Link>assets\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- What this payload was built from, written by tools/stage_payload.py.
         Ships with the build so a copy of the launcher can say which commits
         it came from; the Linux project globs assets\**\* and already had it. -->
    <Content Include="..\..\assets\PAYLOAD_STAMP.json" Link="assets\PAYLOAD_STAMP.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- Same gap for the apworld's provenance record, which sits in Data. -->
    <Content Include="..\..\assets\Data\*.txt">
      <Link>assets\Data\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Sets the exe's icon resource, which WPF also uses for the window and the
         taskbar unless a Window sets its own Icon. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Release identity; shown in the version stamp the patcher writes. -->
    <Version>0.5.0-alpha</Version>
  </PropertyGroup>

  <!-- Publish as a single self-contained exe so the distributable folder is just
       RE4R.AP.Launcher.exe + assets\ instead of ~260 loose runtime DLLs (Cam's
       "the folder is a mess" note). Guarded on RuntimeIdentifier so it engages
       ONLY for a RID-targeted `dotnet publish`; a plain `dotnet build`/F5 dev run
       is untouched. The assets\ tree stays loose beside the exe (Content +
       CopyToOutputDirectory) and every service resolves it via
       AppContext.BaseDirectory, which points at the exe's folder under single-file. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <!-- Don't copy referenced projects' .pdb into the publish output (the RID
         condition on the Core project alone doesn't stop the copy-local step),
         so the distributable stays exe + assets\ only. -->
    <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

</Project>
