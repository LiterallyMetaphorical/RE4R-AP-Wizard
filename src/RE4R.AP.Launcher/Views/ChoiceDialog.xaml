<Window x:Class="RE4R.AP.Launcher.Views.ChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding TitleText}"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="22,18,22,18">
        <TextBlock FontSize="17"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Text="{Binding TitleText}" />
        <TextBlock Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Text="{Binding MessageText}" />
        <!-- Buttons carry their ACTION as the label - never Yes/No (Cam's
             beginner pass: "Yes to do X, No to do Y - whats the difference?").
             Rendered right-aligned, primary action last (Windows convention). -->
        <ItemsControl Margin="0,18,0,0"
                      HorizontalAlignment="Right"
                      ItemsSource="{Binding Choices}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button MinWidth="110"
                            Margin="10,0,0,0"
                            Padding="14,7"
                            Content="{Binding Label}"
                            FontWeight="{Binding FontWeight}"
                            Click="OnChoiceClick" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Window>
