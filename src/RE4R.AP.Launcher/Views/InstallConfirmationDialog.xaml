<Window x:Class="RE4R.AP.Launcher.Views.InstallConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm File Install"
        Width="860"
        Height="560"
        MinWidth="680"
        MinHeight="440"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptTextBlock"
                   FontSize="20"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="1"
                    Margin="0,14,0,10">
            <TextBlock x:Name="SummaryTextBlock"
                       FontSize="15"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="DestinationTextBlock"
                       Margin="0,6,0,0"
                       Foreground="DimGray"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Human summary first: what's inside, grouped - the raw 1000-row
             grid was unreadable in the field (step-0 note) -->
        <Border Grid.Row="2"
                Padding="12"
                Background="#FFF8F8F8"
                BorderBrush="#FFE0E0E0"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock FontWeight="SemiBold"
                           Text="What will be written" />
                <TextBlock x:Name="BreakdownTextBlock"
                           Margin="0,6,0,0"
                           FontFamily="Consolas"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Expander Grid.Row="3"
                  Margin="0,10,0,10"
                  Header="Show every file"
                  IsExpanded="False">
            <DataGrid x:Name="FilesGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      Margin="0,8,0,0"
                      MaxHeight="240"
                      EnableRowVirtualization="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="File"
                                        Binding="{Binding RelativePath}"
                                        Width="5*" />
                    <DataGridTextColumn Header="Size"
                                        Binding="{Binding Size}"
                                        Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Expander>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="110"
                    Margin="0,0,10,0"
                    IsDefault="True"
                    Click="ProceedButton_OnClick"
                    Content="Proceed" />
            <Button Width="110"
                    IsCancel="True"
                    Click="CancelButton_OnClick"
                    Content="Cancel" />
        </StackPanel>
    </Grid>
</Window>
