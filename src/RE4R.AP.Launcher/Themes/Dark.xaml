<!--
    Dark theme, and the launcher's default.

    Same keys as Light.xaml, different values - the two are swapped wholesale at
    runtime, so a key present in one but missing from the other resolves to
    nothing and paints a control invisible. Add to both or neither.

    The accent families are darkened backgrounds with lightened text rather than
    the light theme's colours reused: a pale warning panel on a dark page is a
    flashbang, and dark text on it is unreadable.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dgp="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <!-- Neutrals -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF1B1D21" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF23262B" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF2B2F35" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF2B2F35" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#FF3A3F46" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFE8EAED" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#FF9AA0A6" />

    <!-- Accent: the wizard icon purple (7A5D8F), so selection highlights,
         the theme switch and the primary action all read as the same
         brand rather than a stray green. The dark theme lifts it to
         8F6FA6: the flat 7A5D8F sits too close to the page to register
         as a highlight on a dark surface. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF8F6FA6" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFF7F2FA" />

    <!-- Success / done -->
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#FF7BD69B" />
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#FF1C2E22" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#FF3E6B4E" />

    <!-- Information / in progress -->
    <SolidColorBrush x:Key="InfoTextBrush" Color="#FF8FC4F5" />
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#FF1B2836" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#FF3C5A78" />

    <!-- Warning -->
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FFE8C26A" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FF332A16" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#FF6B5A2E" />

    <!-- Danger / failure -->
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFF08A8A" />
    <SolidColorBrush x:Key="DangerBackgroundBrush" Color="#FF34201F" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#FF7A4444" />

    <!--
        Implicit control styles. WPF's stock control templates are light by
        default, so without these the dark theme would repaint the page and
        leave every text box, dropdown and button glowing white.
    -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="4,3" />
    </Style>

    <!--
        ComboBox has to be re-templated, unlike everything else here.
        Its stock template paints the closed box from its own internal gradients
        and ignores Background entirely, so a themed ComboBox still rendered as a
        white slab with white text on it - invisible. Overriding SystemColors
        fixes the POPUP (and did), but not the box itself.

        This is a plain non-editable template: box, chevron, and a popup that
        takes its colours from the palette. None of the app's combos are
        editable, so PART_EditableTextBox is deliberately absent; adding one
        would be needed before setting IsEditable anywhere.
    -->
    <ControlTemplate x:Key="ThemedComboBoxToggleTemplate" TargetType="ToggleButton">
        <Border x:Name="Bd"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="3">
            <Path x:Name="Arrow"
                  Margin="0,0,9,0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Data="M 0,0 L 8,0 L 4,5 Z"
                  Fill="{DynamicResource SubtleTextBrush}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource SubtleTextBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton ClickMode="Press"
                                      Focusable="False"
                                      Template="{DynamicResource ThemedComboBoxToggleTemplate}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <!-- Full bindings, not TemplateBinding. SelectionBoxItemTemplate
                             is populated after the template is applied (it is derived
                             from DisplayMemberPath), and a TemplateBinding read it too
                             early - which showed the raw record ToString in the box
                             instead of the Label. -->
                        <ContentPresenter Margin="9,0,26,0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          TextElement.Foreground="{DynamicResource TextBrush}"
                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"
                                          ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                          ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               Placement="Bottom"
                               PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
                            <Setter TargetName="Bd" Property="Opacity" Value="0.65" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--
        System colour overrides. This is the half that markup cannot reach: the
        stock WPF templates paint their internals from SystemColors keys, not
        from the control Background you set. The ComboBox POPUP is the obvious
        one, since it takes WindowBrushKey, so without this a dropdown opens as
        a white sheet over a dark page. Context menus, tooltips, scrollbars,
        selection highlights and disabled text all work the same way.

        Overriding the keys means the stock templates come along for the ride
        and nothing has to be re-templated.
    -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF23262B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFE8EAED" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF2B2F35" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFE8EAED" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FF2B2F35" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#FF23262B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#FF3A3F46" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FF23262B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFE8EAED" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#FF2B2F35" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#FFE8EAED" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF8F6FA6" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFF7F2FA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF2B2F35" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFE8EAED" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF7A8087" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ScrollBarBrushKey}" Color="#FF2B2F35" />
    <Color x:Key="{x:Static SystemColors.WindowFrameColorKey}">#FF3A3F46</Color>
    <Color x:Key="{x:Static SystemColors.WindowColorKey}">#FF23262B</Color>
    <Color x:Key="{x:Static SystemColors.ControlColorKey}">#FF2B2F35</Color>

    <!--
        The control families the markup uses that had no themed style of their
        own. Each sets only Background/Foreground/BorderBrush: the stock
        templates are kept, and the system colour keys above handle the
        internals those templates draw for themselves.
    -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="Padding" Value="10,5" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Expander">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource SubtleBorderBrush}" />
    </Style>

    <Style TargetType="dgp:DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    </Style>

    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource InfoTextBrush}" />
    </Style>

</ResourceDictionary>
