<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dev-side companion to BioRandCacheManifestProvider. Three commands:
         generate: hash a VERIFIED-CLEAN biorand-cache into the bundled
                   manifest asset (rerun whenever the bundled BioRand's pak
                   list changes or a game title update lands)
         verify:   check any cache against a manifest (what the launcher does
                   after setup and before each patch)
         diagnose: read a player's launcher-*.log, classify the last BioRand
                   failure the way the launcher now does, and list any
                   harvest X-lines that a clean install would not produce
       Run with `dotnet run -&#45;&#45; help` from this folder for usage. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\RE4R.AP.Launcher.Core\RE4R.AP.Launcher.Core.csproj" />
  </ItemGroup>
</Project>
